# PostgreSQL connection (Postgres 18 running locally)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scheduling_system?schema=public"

# JWT (change secrets before any real deployment)
JWT_SECRET="dev-access-secret-change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN="7d"

# Overtime caps (flag, not block)
DAILY_HOURS_CAP=8
WEEKLY_HOURS_CAP=40
